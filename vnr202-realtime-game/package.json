{
  "name": "vnr202-bomb-arena",
  "version": "1.0.0",
  "private": true,
  "description": "Server-authoritative VNR202 classroom team game",
  "engines": { "node": ">=24" },
  "scripts": {
    "setup": "node scripts/setup.js",
